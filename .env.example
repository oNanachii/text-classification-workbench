SMS_LAB_ROOT=var
SMS_LAB_ADMIN_TOKEN=
SMS_LAB_PUBLIC=false
# Enables only the explicit single-message Jev/compare action; never calls on load.
SMS_LAB_JEV_ENABLED=false
# Only non-public authenticated operators may explicitly select a server key.
# Public BYOK never falls back to this credential. Do not use VITE_* for keys.
SMS_LAB_JEV_SERVER_KEY_ENABLED=false
TYPESAFE_API_KEY=
